{
  "name": "poker-master-tool",
  "version": "2.0.3",
  "description": "Open-source poker hand calculator",
  "main": "dist/index.js",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:docker": "docker-compose up --build",
    "build:all": "npm run build && npm run build:frontend && npm run addon:all",
    "build": "tsc -p tsconfig.backend.json",
    "build:frontend": "npm --prefix frontend run build",
    "addon:all": "npm run addon:configure && npm run addon:build && npm run addon:generate-table",
    "addon:configure": "node-gyp configure",
    "addon:build": "node-gyp rebuild",
    "addon:generate-table": "cd addon/table_generator && make",
    "test": "node --require ts-node/register --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:coverage": "node --require ts-node/register --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.ts\"",
    "lint": "eslint \"**/*.ts\" --fix",
    "test:benchmark": "node tests/benchmark.mjs",
    "test:e2e": "playwright test"
  },
  "author": "Bartosz Putek",
  "license": "MIT",
  "engines": {
    "npm": ">=11.0.0",
    "node": ">=26.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "nan": "^2.29.0",
    "node-gyp": "^13.1.0",
    "supertest": "^7.3.1",
    "tinybench": "^6.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
