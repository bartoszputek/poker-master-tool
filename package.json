{
  "name": "poker-master-tool",
  "version": "2.0.3",
  "private": true,
  "description": "Open-source poker hand calculator",
  "author": "Bartosz Putek",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm --recursive build",
    "start": "pnpm --filter @poker-master-tool/backend start",
    "dev": "pnpm --filter @poker-master-tool/backend dev",
    "dev:frontend": "pnpm --filter @poker-master-tool/frontend dev",
    "dev:docker": "docker-compose up --build",
    "generate-table": "pnpm --filter @poker-master-tool/addon generate-table",
    "test": "pnpm --recursive test",
    "test:coverage": "pnpm --filter @poker-master-tool/backend test:coverage",
    "test:benchmark": "pnpm --filter @poker-master-tool/addon benchmark",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "eslint \"**/*.ts\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
