# The format of the console logs: "json" or "pretty". Use "pretty" only for development.
LOG_FORMAT=json

# Set "true" to also write the logs to files in the "logs" directory.
LOG_TO_FILE=false

# The origin that can send cross-origin requests from a browser. CORS is off when this value is not set.
# CORS_ORIGIN=https://app.example.com

# The directory with the static frontend build. The default is "apps/frontend/build".
# STATIC_DIRECTORY=/app/public
