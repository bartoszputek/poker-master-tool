{
  "name": "@poker-master-tool/backend",
  "version": "2.0.3",
  "private": true,
  "description": "Express API for the poker hand calculator",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --require ts-node/register --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:coverage": "node --require ts-node/register --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.ts\"",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@poker-master-tool/addon": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  }
}
